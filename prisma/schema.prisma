generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ProgrammingProblem {
  id                    Int      @id @default(autoincrement())
  title                 String
  difficulty            String
  topics                Json     @default("[]")
  description           String?
  inputFormat           String?
  outputFormat          String?
  constraints           Json     @default("[]")
  sampleInput           String?
  sampleOutput          String?
  explanation           String?
  testCases             Json     @default("[]")
  hiddenTestCases       Json     @default("[]")
  starterCodeByLanguage Json     @default("{}")
  officialSolutions     Json     @default("{}")
  // Nullable = "use the platform default" (see lib/execution-limits.ts).
  // Existing rows read back as NULL, so old problems keep today's behavior
  // with no backfill needed.
  timeLimitMs           Int?
  memoryLimitKb         Int?
  importedFileName      String?
  status                String   @default("Draft")
  availability          String   @default("Locked")
  // Independent of status/availability — a Draft problem can be marked
  // Premium ahead of publishing, and Published/Available never implies Free.
  accessType            String   @default("FREE")
  // FULL_PROGRAM (default, HackerRank-style — student writes the whole file)
  // or FUNCTION_ONLY (LeetCode-style — student writes only the function
  // body; see lib/wrappers for driver-generation). Existing rows default to
  // FULL_PROGRAM with functionSignature null, so old problems/submissions
  // are completely unaffected.
  executionStyle        String   @default("FULL_PROGRAM")
  // FunctionSignature (lib/wrappers/types.ts), null for FULL_PROGRAM.
  functionSignature     Json?
  // FunctionTestCase[] — structured {args, expected} pairs, only meaningful
  // when executionStyle is FUNCTION_ONLY. Deliberately separate fields from
  // testCases/hiddenTestCases (not a repurposed shape) so a Full Program
  // reader can never misinterpret structured args as raw stdin text.
  functionTestCases       Json   @default("[]")
  functionHiddenTestCases Json   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  submissions           ProgrammingSubmission[]

  @@map("programming_problems")
}

model SqlProblem {
  id                    Int              @id @default(autoincrement())
  title                 String
  difficulty            String
  category              String
  description           String?
  explanation           String?
  schemaSql             String?
  sampleDataSql         String?
  expectedResultColumns Json             @default("[]")
  expectedResultRows    Json             @default("[]")
  hiddenDatasets        Json             @default("[]")
  solutionQuery         String?
  dbEngine              String           @default("MySQL")
  ignoreRowOrder        Boolean          @default(false)
  ignoreColumnOrder     Boolean          @default(false)
  importedFileName      String?
  status                String           @default("Draft")
  availability          String           @default("Locked")
  // Independent of status/availability — see the identical comment on
  // ProgrammingProblem.accessType.
  accessType            String           @default("FREE")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  submissions           SqlSubmission[]

  @@map("sql_problems")
}

model SqlSubmission {
  id              Int        @id @default(autoincrement())
  studentId       String
  studentEmail    String
  problemId       Int
  // Restrict, not Cascade: a problem with submission history must never be
  // deletable in a way that silently destroys students' grading records,
  // leaderboard standing, or dashboard stats. deleteSqlProblem() already
  // blocks this at the application layer; this is the DB-level backstop.
  problem         SqlProblem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  problemTitle    String
  query           String
  verdict         String
  executionTimeMs Int
  passedDatasets  Int
  totalDatasets   Int
  submittedAt     DateTime   @default(now())
  profile         Profile    @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([problemId])
  @@map("sql_submissions")
}

model Profile {
  id                     String                   @id
  email                  String                   @unique
  fullName               String?
  role                   String                   @default("student")
  status                 String                   @default("active")
  // Fast day-to-day access-control read. The Purchase model below is the
  // auditable record of how/when this became true; this flag is what every
  // premium gate actually checks.
  hasLifetimeAccess      Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  sqlSubmissions         SqlSubmission[]
  programmingSubmissions ProgrammingSubmission[]
  purchases              Purchase[]
  passwordHistory        PasswordHistory[]
  auditLogEntries        AdminAuditLog[]

  @@index([role, status])
  @@map("profiles")
}

// Records who did what and when for the admin actions that actually matter
// to be able to trace back later: suspending/reactivating a student,
// granting/revoking manual lifetime access, and creating/editing/deleting a
// problem. Deliberately not exhaustive (read-only actions like viewing a
// student's detail page aren't logged) — this is for accountability on
// state-changing actions, not a full request log.
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    String
  admin      Profile  @relation(fields: [adminId], references: [id])
  // e.g. "student.suspend", "problem.update", "access.grant" — a small,
  // fixed vocabulary maintained by convention at each call site, not an enum
  // in the schema, so adding a new logged action never needs a migration.
  action     String
  // What the action was performed on, if applicable — targetId is a plain
  // string (not an FK) since it spans both String ids (students) and Int
  // ids (problems), and the target may later be deleted while the log entry
  // itself should still make sense on its own.
  targetType String?
  targetId   String?
  // Small, non-sensitive extra context (e.g. { previousStatus, newStatus },
  // { title }) — never raw student PII beyond what's already in targetId,
  // never secrets.
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("admin_audit_log")
}

// Independent of Supabase Auth's own password storage, which this app has no
// read access to (and shouldn't) — every successful password change records
// its own hash here (see lib/auth/password-history.ts), so a new password
// can be checked against the student's recent ones without ever touching
// Supabase's internal storage. Pruned to the most recent few entries per
// student on every write, so this never grows unbounded.
model PasswordHistory {
  id           Int      @id @default(autoincrement())
  studentId    String
  profile      Profile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([studentId])
  @@map("password_history")
}

// Auditable purchase history, kept separate from Profile.hasLifetimeAccess
// so there's a real record of how/when access was granted — either an admin
// using grantLifetimeAccess() (provider: "manual") or a real Razorpay
// payment (provider: "razorpay", providerReference: the Razorpay payment id).
model Purchase {
  id                Int      @id @default(autoincrement())
  studentId         String
  profile           Profile  @relation(fields: [studentId], references: [id])
  provider          String   @default("manual")
  providerReference String?
  // Smallest currency unit (paise for INR) — null for manual grants, which
  // have no real transaction amount.
  amount            Int?
  currency          String   @default("INR")
  status            String   @default("completed")
  createdAt         DateTime @default(now())

  // A real payment can legitimately be recorded twice — once via the
  // client-side checkout success callback, once via the Razorpay webhook
  // (defense in depth, since the webhook is the source of truth if the
  // browser closes before the callback fires). This constraint makes that
  // safe: the second attempt hits a unique-constraint error instead of
  // creating a duplicate row (see recordPurchaseAndGrantAccess in
  // lib/payments/access.ts). Safe against existing manual-grant rows —
  // Postgres treats multiple NULL providerReferences as distinct.
  @@unique([provider, providerReference])
  @@index([studentId])
  @@map("purchases")
}

// Singleton row (id is always 1) — the live admin-editable payments switch.
// A new concept for this codebase; kept to exactly the two fields actually
// needed rather than a general key-value settings table, since nothing else
// requires one yet.
model PlatformSettings {
  id                   Int      @id @default(1)
  paymentsEnabled      Boolean  @default(false)
  // Rupees, not paise — converted to paise only when creating a Razorpay
  // order, so this stays human-readable in the admin UI and DB.
  subscriptionPriceInr Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@map("platform_settings")
}

model ProgrammingSubmission {
  id              Int                @id @default(autoincrement())
  studentId       String
  studentEmail    String
  problemId       Int
  // Restrict, not Cascade — see the identical comment on SqlSubmission.problem.
  problem         ProgrammingProblem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  problemTitle    String
  language        String
  code            String
  verdict         String
  executionTimeMs Int
  memoryKb        Int
  passedTests     Int
  totalTests      Int
  submittedAt     DateTime           @default(now())
  profile         Profile            @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([problemId])
  @@map("programming_submissions")
}

// Short-lived lock preventing a student from grading the same problem twice
// concurrently (multi-tab / rapid double-submit). Acquired right before
// grading starts and released right after — rows should never persist beyond
// a single request's lifetime except in a crash, which the stale-lock check
// in submit-code.ts reclaims after 30s.
model ProgrammingSubmissionLock {
  studentId String
  problemId Int
  createdAt DateTime @default(now())

  @@id([studentId, problemId])
  @@map("programming_submission_locks")
}

// Mirrors ProgrammingSubmissionLock exactly, for the SQL judge.
model SqlSubmissionLock {
  studentId String
  problemId Int
  createdAt DateTime @default(now())

  @@id([studentId, problemId])
  @@map("sql_submission_locks")
}
