# Supabase — get these from your project's API settings:
# https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public URL of the app — used to build password-reset email links.
# Set to your production domain when deploying (e.g. https://yourapp.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
